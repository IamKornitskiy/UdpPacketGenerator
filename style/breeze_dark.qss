/* ============================================================================
   Breeze Dark Theme for UDP Packet Generator
   Inspired by KDE Plasma Breeze Dark theme
   ============================================================================ */

/* ---- Global ---- */
QMainWindow, QDialog {
    background-color: #2a2e32;
}

/* ---- Group Box ---- */
QGroupBox {
    font-weight: bold;
    border: 1px solid #4a4e52;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 14px;
    padding-bottom: 8px;
    background-color: #31363b;
}

QGroupBox:hover {
    border-color: #5a5e62;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    color: #e5e6e7;
}

/* ---- Push Buttons (Breeze Dark style) ---- */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #4a4e52, stop:0.5 #3a3e42, stop:1 #2a2e32);
    color: #e5e6e7;
    border: 1px solid #4a4e52;
    border-radius: 5px;
    padding: 6px 18px;
    font-weight: normal;
    font-size: 13px;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #5a5e62, stop:0.5 #4a4e52, stop:1 #3a3e42);
    border-color: #5a5e62;
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #2a2e32, stop:0.5 #3a3e42, stop:1 #4a4e52);
}

QPushButton:disabled {
    background: #3a3e42;
    color: #6a6e72;
    border-color: #4a4e52;
}

/* Primary action button (Start, Load) */
QPushButton[primary="true"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #3daee9, stop:0.5 #2a9ad9, stop:1 #1f89c7);
    color: white;
    border-color: #1f89c7;
}

QPushButton[primary="true"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #5fbff2, stop:0.5 #3daee9, stop:1 #2a9ad9);
    border-color: #2a9ad9;
}

QPushButton[primary="true"]:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #1f89c7, stop:0.5 #1a78b0, stop:1 #15679a);
    border-color: #15679a;
}

QPushButton[primary="true"]:disabled {
    background: #3a5a6a;
    color: #6a8a9a;
    border-color: #2a4a5a;
}

/* Danger button (Stop) */
QPushButton[danger="true"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #da4453, stop:0.5 #cc3f4f, stop:1 #b83343);
    color: white;
    border-color: #b83343;
}

QPushButton[danger="true"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #e55a68, stop:0.5 #da4453, stop:1 #cc3f4f);
    border-color: #cc3f4f;
}

QPushButton[danger="true"]:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #b83343, stop:0.5 #a02838, stop:1 #8a1f2e);
    border-color: #8a1f2e;
}

QPushButton[danger="true"]:disabled {
    background: #6a3a3a;
    color: #9a6a6a;
    border-color: #5a2a2a;
}

/* ---- Input Fields ---- */
QLineEdit, QSpinBox, QDoubleSpinBox, QPlainTextEdit {
    border: 1px solid #4a4e52;
    border-radius: 5px;
    padding: 6px 10px;
    background-color: #2a2e32;
    color: #e5e6e7;
    font-size: 13px;
}

QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QPlainTextEdit:hover {
    border-color: #5a5e62;
    background-color: #32363a;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QPlainTextEdit:focus {
    border-color: #3daee9;
    background-color: #2a3a42;
}

/* ---- Scroll Bars ---- */
QScrollBar:vertical {
    background: #2a2e32;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #4a4e52;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #5a5e62;
}

QScrollBar::handle:vertical:pressed {
    background: #6a6e72;
}

/* ---- Status Bar ---- */
QStatusBar {
    background: #2a2e32;
    color: #e5e6e7;
    border-top: 1px solid #3a3e42;
    padding: 4px 8px;
}

#statusIndicator {
    background: #4a4e52;
    border-radius: 6px;
    border: 1px solid #5a5e62;
}

#statusText {
    color: #e5e6e7;
    font-size: 13px;
    background: transparent;
}



/* ---- Scroll Area ---- */
QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

/* ---- Labels ---- */
QLabel {
    color: #e5e6e7;
    background: transparent;
}

/* ---- Title Bar (Breeze Dark style) ---- */
#titleBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #31363b, stop:1 #2a2e32);
    border-bottom: 1px solid #3a3e42;
    padding: 4px 8px;
}

#titleBar QLabel {
    color: #e5e6e7;
    font-size: 14px;
    font-weight: bold;
}

#titleBar QPushButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    color: #e5e6e7;
    padding: 4px 8px;
    font-size: 13px;
}

#titleBar QPushButton:hover {
    background-color: #4a4e52;
    color: #ffffff;
}

#titleBar QPushButton:pressed {
    background-color: #5a5e62;
}

#titleBar #closeButton:hover {
    background-color: #da4453;
    color: white;
}

#titleBar #closeButton:pressed {
    background-color: #bf3a47;
}

/* ---- Menu Bar (Breeze Dark style) ---- */
#titleMenuBar {
    background: transparent;
    color: #e5e6e7;
    font-size: 13px;
    padding-top: 6px;
    padding-bottom: 4px;
    border: none;
    border-bottom: 1px solid rgba(255,255,255,0.1);
}

#titleMenuBar::item {
    background: transparent;
    padding: 4px 8px;
    border-radius: 4px;
    margin: 0px;
}

#titleMenuBar::item:selected {
    background: #4a4e52;
    color: #ffffff;
}

#titleMenuBar QMenu {
    background: #31363b;
    border: 1px solid #4a4e52;
    border-radius: 6px;
    padding: 4px 0px;
}

#titleMenuBar QMenu::item {
    padding: 6px 24px;
    color: #e5e6e7;
}

#titleMenuBar QMenu::item:selected {
    background: #4a4e52;
    color: #ffffff;
}

#titleMenuBar QMenu::separator {
    height: 1px;
    background: #4a4e52;
    margin: 4px 8px;
}
