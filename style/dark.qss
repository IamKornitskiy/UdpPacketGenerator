QMainWindow, QDialog {
    background-color: #1e1e1e;
}

QGroupBox {
    font-weight: bold;
    border: 1px solid #3d4f5d;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 14px;
    padding-bottom: 8px;
    background-color: #2d2d30;
}

QGroupBox:hover {
    border-color: #4a5c6a;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    color: #dddddd;
}

QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #0078d4, stop:1 #106ebe);
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 20px;
    font-weight: bold;
    font-size: 13px;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #106ebe, stop:1 #1a7fc4);
    padding: 8px 22px;
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #005a9e, stop:1 #0078d4);
}

QPushButton:disabled {
    background: #3d4f5d;
    color: #888888;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QPlainTextEdit {
    border: 1px solid #4a5c6a;
    border-radius: 6px;
    padding: 6px 10px;
    background-color: #2c3e50;
    color: #dddddd;
    font-size: 13px;
}

QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QPlainTextEdit:hover {
    border-color: #5a7a8a;
    background-color: #324456;
}

QPlainTextEdit[error="true"] {
    border: 1px solid #ff4444;   /* red */
}

QPlainTextEdit[error="false"] {
    border: 1px solid #44ff44;   /* green */
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QPlainTextEdit:focus {
    border-color: #3498db;
    background-color: #2a3c4e;
}

QScrollBar:vertical {
    background: #2d2d30;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #4a5c6a;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #5a7a8a;
}

QScrollBar::handle:vertical:pressed {
    background: #6a8a9a;
}

QStatusBar {
    background: #2d2d30;
    color: #dddddd;
    border-top: 1px solid #3d4f5d;
    padding: 4px 8px;
}

#statusIndicator {
    background: #4a5c6a;
    border-radius: 6px;
    border: 1px solid #5a7a8a;
}

#statusText {
    color: #dddddd;
    font-size: 13px;
    background: transparent;
}

QLabel {
    color: #dddddd;
    background: transparent;
}

QScrollArea {
    background-color: #2d2d30;
}

QScrollArea > QWidget > QWidget {
    background-color: #2d2d30;
}

#titleBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1e1e1e, stop:1 #252525);
    border-bottom: 1px solid #3d4f5d;
    padding: 4px 8px;
}

#titleBar QLabel {
    color: #dddddd;
    font-size: 14px;
    font-weight: bold;
}

#titleBar QPushButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    color: #dddddd;
    padding: 4px 8px;
    font-weight: normal;
    font-size: 13px;
}

#titleBar QPushButton:hover {
    background-color: #3d4f5d;
    color: #ffffff;
}

#titleBar QPushButton:pressed {
    background-color: #4a5c6a;
}

#titleBar #closeButton:hover {
    background-color: #E81123;
    color: white;
}
#titleBar #closeButton:pressed {
    background-color: #BF0F1A;
}

/* Menu bar styles */
#titleMenuBar {
    background: transparent;
    color: #dddddd;
    font-size: 13px;
    padding-top: 6px;
    padding-bottom: 4px;
    border: none;
    border-bottom: 1px solid rgba(255,255,255,0.1);
}

#titleMenuBar::item {
    background: transparent;
    padding: 4px 8px;
    border-radius: 4px;
    margin: 0px;
}

#titleMenuBar::item:selected {
    background: #3d4f5d;
    color: #ffffff;
}

#titleMenuBar QMenu {
    background: #2d2d30;
    border: 1px solid #3d4f5d;
    border-radius: 6px;
    padding: 4px 0px;
}

#titleMenuBar QMenu::item {
    padding: 6px 24px;
    color: #dddddd;
}

#titleMenuBar QMenu::item:selected {
    background: #3d4f5d;
    color: #ffffff;
}

#titleMenuBar QMenu::separator {
    height: 1px;
    background: #3d4f5d;
    margin: 4px 8px;
}
